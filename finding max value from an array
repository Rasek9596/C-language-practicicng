//finding max value from an user given array.
#include<stdio.h>

int fm(int ara[], int n);

int main()
{
    int n;

    printf("The maximum elements of the array: ");
    scanf("%d", &n);

    int ara[n];

    printf("array: ");
    for(int i= 0; i< n; i++){
        scanf("%d", &ara[i]);
    }

    int max = fm(ara, n);
    printf("\nThe Maximum value of the array is: %d\n", max);
    
    return 0;
}

int fm(int ara[], int n)
{
    int max = ara[0];
    int i;
    
    for(i = 1; i<n ; i++){
        if(ara[i] > max){
            max = ara[i];
        }
    }

    return max;
}
